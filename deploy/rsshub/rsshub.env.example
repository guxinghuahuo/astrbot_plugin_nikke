# Copy to rsshub.env. These variables are passed only to the RSSHub container.
# With no configured Cookie, Chromium attempts to obtain an anonymous session.
# If the Bilibili route fails, set a complete login Cookie below.
# Replace LOGIN_UID with the UID of the account owning the Cookie (not the UP).
# Keep a literal Cookie in single quotes to prevent Compose interpolation.
# Do not add an empty BILIBILI_COOKIE_* variable.
# BILIBILI_COOKIE_LOGIN_UID='SESSDATA=...; bili_jct=...; DedeUserID=...; ...'
