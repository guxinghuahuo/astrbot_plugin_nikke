# Copy to .env on the NAS. This file controls Docker Compose interpolation.
NAS_BIND_IP=127.0.0.1
RSSHUB_PORT=1200

# Generate with: openssl rand -hex 32
BROWSERLESS_TOKEN=

# After a successful deployment, pin these to the tested image digests.
# DaoCloud mirror for mainland China; no Docker daemon changes required.
# 2026-10-24 multi-platform image; upstream revision ab97c632 supports USER_ROUTES_PATH.
RSSHUB_IMAGE=m.daocloud.io/docker.io/diygod/rsshub@sha256:e34292f03edd2e42095cd27094d9b7179f7d89a684313e8f91c3ce73a7de354d
BROWSERLESS_IMAGE=m.daocloud.io/ghcr.io/browserless/chromium:latest
REDIS_IMAGE=m.daocloud.io/docker.io/library/redis:alpine
